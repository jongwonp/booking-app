generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReservationStatus {
  HOLD
  CONFIRMED
  CANCELLED
}

model User {
  id        String        @id @default(uuid())
  email     String        @unique
  name      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  reservations Reservation[]
}

model Listing {
  id           String        @id @default(uuid())
  slug         String        @unique
  title        String
  nightlyPrice Int
  location     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
}

model Reservation {
  id         String             @id @default(uuid())
  userId     String
  listingId  String
  checkIn    DateTime
  checkOut   DateTime
  status     ReservationStatus  @default(HOLD)
  totalPrice Int
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@index([listingId, checkIn, checkOut])
  @@index([status])
}
